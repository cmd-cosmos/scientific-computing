   "metadata": {},
   "outputs": [],
   "source": [
    "def f(x):\n",
    "    return np.exp(-x**90)\n",
    "\n",
    "res, err = integrate.quad(f, 0, np.inf)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
